{
  "name": "GemParticles Development",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined",
    "-e", "DISPLAY=${env:DISPLAY}",
    "-v", "/tmp/.X11-unix:/tmp/.X11-unix",
    "-v", "${localWorkspaceFolder}/.devcontainer/.ccls-cache:/root/.ccls-cache"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cpptools-themes",
        "ms-vscode-remote.remote-containers",
        "vadimcn.vscode-lldb",
        "NVIDIA.nsight-vscode-edition"
      ],
      "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "cmake.configureOnOpen": true,
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.generator": "Unix Makefiles",
        "C_Cpp.enhancedColorization": "Enabled"
      }
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "chmod +x ${containerWorkspaceFolder}/.devcontainer/post-create.sh && ${containerWorkspaceFolder}/.devcontainer/post-create.sh",
  "mounts": [
    "source=${localWorkspaceFolder}/build,target=/app/build,type=bind,consistency=cached"
  ],
  "forwardPorts": []
} 